---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Delete your Kadence account | Kadence"
  description="Request permanent deletion of your Kadence account and associated data. Verify ownership by email — no app required."
  path="delete-account/"
>
  <div class="stack">
    <section class="card" aria-labelledby="page-title">
    <span class="badge">
      <Icon name="shield" size={14} />
      Official Kadence account page
    </span>

    <h1 id="page-title" style="margin-top: 1rem">Delete your Kadence account</h1>
    <p class="lead">
      Permanently delete your Kadence account and associated data.
    </p>

    <hr class="divider" />

    <!-- Step 1: request the verification email. -->
    <div data-panel="form">
      <p class="prose">
        For your security, we verify that a deletion request comes from the
        account owner. Enter the email address on your Kadence account and
        we&rsquo;ll send you a link to confirm.
      </p>

      <form data-role="request-form" novalidate style="margin-top: 1.25rem">
        <div class="field">
          <label class="field__label" for="email">
            Email address
            <span class="field__required" aria-hidden="true">*</span>
          </label>
          <input
            class="input"
            id="email"
            name="email"
            data-role="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            autocapitalize="none"
            spellcheck="false"
            maxlength="254"
            required
            placeholder="you@example.com"
            aria-describedby="email-hint email-error"
          />
          <p class="field__hint" id="email-hint">
            Use the address associated with your Kadence account.
          </p>
          <p
            class="field__error"
            id="email-error"
            data-role="email-error"
            role="alert"
          >
          </p>
        </div>

        <div class="actions">
          <button class="button button--primary" type="submit" data-role="submit">
            <span class="spinner"></span>
            <span data-role="submit-label">Request account deletion</span>
          </button>
        </div>
      </form>

      <p class="muted" style="margin-top: 1.1rem">
        We&rsquo;ll email a verification link to the address associated with the
        account. Nothing is deleted until you open that link and confirm.
      </p>

      <noscript>
        <p class="notice notice--danger">
          <Icon name="alert" size={18} />
          <span>
            JavaScript is required to send this request. Enable JavaScript and
            reload the page, or contact Kadence support from another device.
          </span>
        </p>
      </noscript>
    </div>

    <!-- Step 2: neutral confirmation. Shown for every successful submission,
         whether or not an account exists for the address. -->
    <div class="status" data-panel="sent" hidden>
      <span class="status__icon status__icon--success">
        <Icon name="check" size={22} />
      </span>
      <h2 class="status__heading" data-panel-heading>Check your email</h2>
      <p class="prose">
        If an account exists for this email address, we&rsquo;ve sent
        instructions to verify your request and continue with account deletion.
      </p>
      <p class="muted" style="margin-top: 0.75rem">
        The link expires shortly, so use it soon. If it doesn&rsquo;t arrive,
        check your spam folder.
      </p>
      <div class="actions">
        <button
          class="button button--ghost"
          type="button"
          data-role="return-to-form"
        >
          Use a different email address
        </button>
      </div>
    </div>

    <!-- Error: transport failure only, never an account-existence signal. -->
    <div class="status" data-panel="error" hidden>
      <span class="status__icon status__icon--error">
        <Icon name="alert" size={22} />
      </span>
      <h2
        class="status__heading"
        data-panel-heading
        data-role="error-heading"
      >
        Something went wrong
      </h2>
      <p class="prose" data-role="error-message">
        We couldn&rsquo;t process your request right now. Please try again.
      </p>
      <div class="actions">
        <button class="button button--primary" type="button" data-role="retry">
          Try again
        </button>
      </div>
    </div>
    </section>

    <p class="muted">
      This page works even if you have uninstalled the Kadence app. Deleting your
      account is permanent and cannot be undone.
    </p>
  </div>
</BaseLayout>

<script>
  import { resolveAccountDeletionApi } from '../../lib/api';
  import { mountDeleteRequestForm } from '../../lib/delete-request-form';

  mountDeleteRequestForm({
    root: document,
    api: resolveAccountDeletionApi(),
  });
</script>
