---
// The site exists for one purpose, so the root forwards to it. A static
// meta-refresh page (rather than Astro.redirect) keeps the output fully
// static and needs nothing from the host.
const destination = '/delete-account/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kadence account management</title>
    <meta
      name="description"
      content="Kadence account management: permanently delete your Kadence account."
    />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <link rel="canonical" href={destination} />
    <style>
      body {
        margin: 0;
        display: grid;
        min-height: 100dvh;
        place-items: center;
        padding: 1.5rem;
        background: #ffffff;
        color: #111111;
        font-family:
          ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif;
        font-size: 1.0625rem;
        line-height: 1.75;
        text-align: center;
      }
      a {
        color: #0a4d9c;
        text-underline-offset: 0.15em;
      }
    </style>
  </head>
  <body>
    <p>
      Redirecting to
      <a href={destination}>Kadence account management</a>&hellip;
    </p>
  </body>
</html>
