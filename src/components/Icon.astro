---
/**
 * Inline icon set.
 *
 * Inlined rather than loaded from an icon package: the site needs a handful of
 * glyphs, and inlining keeps them dependency-free, colour-inheriting and
 * unaffected by an extra network request.
 */
interface Props {
  name: 'check' | 'alert' | 'info' | 'shield';
  size?: number;
}

const { name, size = 20 } = Astro.props;

const paths: Record<Props['name'], string> = {
  check: '<path d="M20 6 9 17l-5-5"/>',
  alert:
    '<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
  info: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
