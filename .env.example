# ---------------------------------------------------------------------------
# Kadence account-deletion site — local environment
# ---------------------------------------------------------------------------
# Copy to `.env` for local development.
#
# IMPORTANT: only PUBLIC_* values are read by this project. They are embedded
# into the generated static files at build time and are therefore NOT SECRET.
# Never put credentials, API keys or signing secrets in a PUBLIC_* variable.
# ---------------------------------------------------------------------------

# Base URL of the Kadence API (no trailing slash).
# Production requests must use HTTPS; plain http:// is accepted only for
# localhost during development.
PUBLIC_API_BASE_URL=http://localhost:3000

# Uncomment to exercise the site against the bundled mock API instead:
# PUBLIC_API_BASE_URL=

# Optional: public site URL used for canonical + Open Graph tags.
# Production is served from https://kadence.static.barryph.com while the API
# lives on a separate origin, https://kadence.barryph.com.
# SITE_URL=https://kadence.static.barryph.com
